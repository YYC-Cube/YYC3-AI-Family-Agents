{
  "schema": "yyc3.golden/v1",
  "volume": "business-zh",
  "description": "业务域中文卷——题源 = presets/profiles/domains/ 八家人业务域卡（E1b × E4a 交扣 · 32 题）",
  "cases": [
    { "id": "B01", "sourceProfile": "investor-briefing", "owner": "thinker", "prompt": "120 间房，ADR 380，入住率 82%：一笔给出当月 RevPAR（元，保留一位小数）与两句结论。", "assert": { "keywords": ["311.6"], "numbers": ["311.6"], "minHitRatio": 0.5 } },
    { "id": "B02", "sourceProfile": "investor-briefing", "owner": "thinker", "prompt": "项目初始投 2400 万，年净现金流 460 万：给回收期（年，保留一位小数）与一条敏感性提示。", "assert": { "keywords": ["5.2"], "numbers": ["5.2"], "minHitRatio": 0.5 } },
    { "id": "B03", "sourceProfile": "investor-briefing", "owner": "thinker", "prompt": "两方案：甲 IRR 11% 回收 7 年；乙 IRR 9% 回收 5 年。给一页纸结论（先结论后理由，注明数据来源为本题给定）。", "assert": { "keywords": ["结论", "IRR"], "minHitRatio": 0.5 } },
    { "id": "B04", "sourceProfile": "investor-briefing", "owner": "thinker", "prompt": "缺 3 个月经营数据的情况下，投资人问全年预测：按你的口径作答（缺数必须明示，不得编造）。", "assert": { "antiKeywords": ["编造数据将"], "keywords": ["缺", "假设"], "minHitRatio": 0.4 } },
    { "id": "B05", "sourceProfile": "intent-routing", "owner": "qianhang", "prompt": "用户说『帮我把这周的巡检排一下』：给 intent（analysis|orchestration|prediction|chat）与置信度，缺槽列明。", "assert": { "keywords": ["orchestration"], "minHitRatio": 0.4 } },
    { "id": "B06", "sourceProfile": "intent-routing", "owner": "qianhang", "prompt": "用户说『看看上月电费啥趋势』：给 intent 与置信度（prediction 为期望主类，仅记录不断言人工）。", "assert": { "keywords": ["prediction"], "minHitRatio": 0.4 } },
    { "id": "B07", "sourceProfile": "intent-routing", "owner": "qianhang", "prompt": "用户发来『你好呀』：给 intent 与置信度，并说明是否需要澄清。", "assert": { "keywords": ["chat"], "minHitRatio": 0.4 } },
    { "id": "B08", "sourceProfile": "intent-routing", "owner": "qianhang", "prompt": "用户说『把这数据跟去年比比再讲讲明年』：给 intent；若跨类说明主类与次类，缺槽列明。", "assert": { "keywords": ["analysis"], "minHitRatio": 0.3 } },
    { "id": "B09", "sourceProfile": "talent-matching", "owner": "bole", "prompt": "岗位要『连锁酒店店长，5 年经验，能带 20 人团队』；候选人 4 年单体酒店店长：给匹配结论（不合适也诚实相告）与理由链。", "assert": { "keywords": ["不合适", "理由"], "minHitRatio": 0.5 } },
    { "id": "B10", "sourceProfile": "talent-matching", "owner": "bole", "prompt": "给『会员运营专员』岗列最小够用的候选人画像维度（不超过 6 项，逐项一句话）。", "assert": { "keywords": ["经验", "能力"], "minHitRatio": 0.3 } },
    { "id": "B11", "sourceProfile": "talent-matching", "owner": "bole", "prompt": "候选人 A 技能全中但稳定性存疑（两年三跳）：给推荐卡（含匹配度百分数与风险注记）。", "assert": { "keywords": ["风险", "匹配"], "minHitRatio": 0.5 } },
    { "id": "B12", "sourceProfile": "talent-matching", "owner": "bole", "prompt": "把『门店经理/店长/分店负责人』归并为一个岗位标签并说明归并理由。", "assert": { "keywords": ["门店经理"], "minHitRatio": 0.4 } },
    { "id": "B13", "sourceProfile": "trend-forecast", "owner": "prophet", "prompt": "近 6 个月会员数：1200/1180/1230/1250/1240/1260：先声明基线与窗口，再给下月情景区间（不担保单点）。", "assert": { "keywords": ["窗口", "区间"], "minHitRatio": 0.5 } },
    { "id": "B14", "sourceProfile": "trend-forecast", "owner": "prophet", "prompt": "只有 5 天数据却被要求预测下季度：按样本不足口径作答。", "assert": { "keywords": ["样本", "不足"], "minHitRatio": 0.5 } },
    { "id": "B15", "sourceProfile": "trend-forecast", "owner": "prophet", "prompt": "能耗连续 3 周上行（+2%/+4%/+7%）：给预警分级（watch|alert|critical）与触发理由。", "assert": { "keywords": ["alert", "watch"], "minHitRatio": 0.3 } },
    { "id": "B16", "sourceProfile": "trend-forecast", "owner": "prophet", "prompt": "给出『乐观/中性/悲观』三情景的 occupancy 预测骨架（各一行，含假设条件）。", "assert": { "keywords": ["中性", "假设"], "minHitRatio": 0.5 } },
    { "id": "B17", "sourceProfile": "brand-content", "owner": "grace", "prompt": "为中端酒店写 3 条OTA 标题（每条 ≤18 字，附实现提示：放哪个渠道、配什么图）。", "assert": { "keywords": ["渠道"], "minHitRatio": 0.3 } },
    { "id": "B18", "sourceProfile": "brand-content", "owner": "grace", "prompt": "给会员日海报文案骨架：主标语 1 + 副标语 1 + 行动按钮文案 1（说明留白与强调色用法）。", "assert": { "keywords": ["主标语", "留白"], "minHitRatio": 0.4 } },
    { "id": "B19", "sourceProfile": "brand-content", "owner": "grace", "prompt": "文案引用了『某调研显示 90% 用户偏好』但无出处：按引用纪律给出处置。", "assert": { "keywords": ["来源", "出处"], "minHitRatio": 0.4 } },
    { "id": "B20", "sourceProfile": "brand-content", "owner": "grace", "prompt": "给『含酒精饮品促销』文案做合规预检清单（3 条，注明先过守护）。", "assert": { "keywords": ["守护", "合规"], "minHitRatio": 0.4 } },
    { "id": "B21", "sourceProfile": "quality-audit", "owner": "grandmaster", "prompt": "评审一份报告：数据无来源、结论无量化：按 blocker|major|minor 分级给问题清单与修复建议。", "assert": { "keywords": ["major", "来源"], "minHitRatio": 0.4 } },
    { "id": "B22", "sourceProfile": "quality-audit", "owner": "grandmaster", "prompt": "给『周报模板』设计 5 项量化评分表（维度 + 0-5 分标准）。", "assert": { "keywords": ["维度", "评分"], "minHitRatio": 0.5 } },
    { "id": "B23", "sourceProfile": "quality-audit", "owner": "grandmaster", "prompt": "下属流程跑得好（失误率 0.2%）：除表扬外，按好实践沉淀口径给 SOP 条目化建议。", "assert": { "keywords": ["SOP"], "minHitRatio": 0.4 } },
    { "id": "B24", "sourceProfile": "quality-audit", "owner": "grandmaster", "prompt": "一份验收材料含 2 个 blocker、3 个 minor：给放行结论与理由（直言不讳）。", "assert": { "keywords": ["不放行", "blocker"], "minHitRatio": 0.4 } },
    { "id": "B25", "sourceProfile": "compliance-scan", "owner": "guardian", "prompt": "发现测试脚本把令牌写进代码：定级（阻断/告警/提示）+ 处置动作 + 上报口径。", "assert": { "keywords": ["阻断", "上报"], "minHitRatio": 0.4 } },
    { "id": "B26", "sourceProfile": "compliance-scan", "owner": "guardian", "prompt": "扫描报告误报一处『路径穿越』：按误报处置口径作答（证据链 + 复核路径）。", "assert": { "keywords": ["证据", "复核"], "minHitRatio": 0.5 } },
    { "id": "B27", "sourceProfile": "compliance-scan", "owner": "guardian", "prompt": "巡检发现越权访问尝试：给 30 秒内告警话术（分级 + 事实先行）。", "assert": { "keywords": ["告警"], "minHitRatio": 0.4 } },
    { "id": "B28", "sourceProfile": "compliance-scan", "owner": "guardian", "prompt": "给审计日志设计 3 条不可篡改性检查项（事实与等级先行）。", "assert": { "keywords": ["审计"], "minHitRatio": 0.4 } },
    { "id": "B29", "sourceProfile": "ops-decision", "owner": "tianshu", "prompt": "预算 100 万三选一：消防改造（合规刚需）/大堂翻新（体验）/会员系统（增长）：给三方案与加权评分表（30/25/20/15/10）。", "assert": { "keywords": ["三方案", "评分"], "minHitRatio": 0.5 } },
    { "id": "B30", "sourceProfile": "ops-decision", "owner": "tianshu", "prompt": "门店 A 利润高但集团要求扶植新品牌：按局部服从全局口径给仲裁意见。", "assert": { "keywords": ["全局"], "minHitRatio": 0.4 } },
    { "id": "B31", "sourceProfile": "ops-decision", "owner": "tianshu", "prompt": "给『是否引入机器人送餐』决策备忘：三方案 + 各自关键假设（显式列出）。", "assert": { "keywords": ["假设"], "minHitRatio": 0.4 } },
    { "id": "B32", "sourceProfile": "ops-decision", "owner": "tianshu", "prompt": "复盘一次决策失误：按可追溯口径给记录骨架（决策点/依据/偏差/改进）。", "assert": { "keywords": ["追溯", "依据"], "minHitRatio": 0.5 } }
  ]
}
