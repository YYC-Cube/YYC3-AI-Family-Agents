{
  "$schema": "../schemas/agent-card.schema.json",
  "agentCard": {
    "name": "预见·先知 (Prophet)",
    "description": "YYC³ AI Family 首席预言家 · 趋势之眼 — 趋势预测与风险评估，负责早期预警与情景推演。",
    "url": "https://matrix.yyc3.top/family/prophet",
    "version": "1.1.0",
    "provider": {
      "organization": "YanYuCloudCube",
      "url": "https://yyc3.top"
    },
    "capabilities": {
      "streaming": false,
      "pushNotifications": false,
      "stateTransitionHistory": true
    },
    "skills": [
      {
        "id": "shared.self-judge",
        "name": "结构化自判断",
        "description": "产出置信度、登记假设、检测偏离并给出升级决策",
        "tags": [
          "confidence",
          "assumption",
          "escalation"
        ],
        "examples": [
          "对候选意图给出 0..1 置信度并显式登记假设"
        ]
      },
      {
        "id": "shared.memory-retrieve",
        "name": "记忆检索",
        "description": "按语义与上下文检索情景/语义/程序记忆",
        "tags": [
          "memory",
          "retrieval"
        ],
        "examples": [
          "检索同一客户近三次决策的上下文"
        ]
      },
      {
        "id": "shared.memory-write",
        "name": "记忆写入",
        "description": "按写入策略落盘情景记忆与程序记忆条目",
        "tags": [
          "memory",
          "write",
          "procedural"
        ],
        "examples": [
          "把本轮结论写入情景记忆并标注显著性"
        ]
      },
      {
        "id": "shared.experience-reflow",
        "name": "经验回流",
        "description": "轨迹采集、模式提炼与学习周期触发",
        "tags": [
          "trajectory",
          "learning"
        ],
        "examples": [
          "把一次成功分析沉淀为可复用轨迹"
        ]
      },
      {
        "id": "shared.observe-emit",
        "name": "指标与追踪埋点",
        "description": "以 traceId 贯穿事件并写入 family_* 指标",
        "tags": [
          "metrics",
          "tracing"
        ],
        "examples": [
          "为任务执行记录 outcome 与耗时并保留 traceId"
        ]
      },
      {
        "id": "prophet.trend-forecast",
        "name": "趋势预测",
        "description": "时间序列趋势外推与区间估计",
        "tags": [
          "forecast",
          "time-series"
        ],
        "examples": [
          "预测未来三个月订单量区间并标注置信带"
        ]
      },
      {
        "id": "prophet.risk-alert",
        "name": "风险预警",
        "description": "异常模式识别与提前预警，附触发阈值",
        "tags": [
          "risk",
          "alert"
        ],
        "examples": [
          "现金流连续两月下滑时触发橙色预警"
        ]
      },
      {
        "id": "prophet.capacity-forecast",
        "name": "容量与算力预警",
        "description": "设备矩阵与算力负载的趋势预判",
        "tags": [
          "capacity",
          "compute"
        ],
        "examples": [
          "推理队列积压趋势提示扩容窗口"
        ]
      },
      {
        "id": "prophet.scenario-simulate",
        "name": "场景推演",
        "description": "多情景假设下的结果推演与敏感度分析",
        "tags": [
          "scenario",
          "simulation"
        ],
        "examples": [
          "涨价 5% 与不涨价两种情景的毛利推演"
        ]
      }
    ],
    "defaultInputModes": [
      "text",
      "structured"
    ],
    "defaultOutputModes": [
      "text",
      "structured"
    ],
    "authentication": {
      "schemes": [
        "bearer_token",
        "api_key"
      ],
      "required": true
    },
    "security": {
      "tlsRequired": true,
      "signedAgentCard": false,
      "rbacRoles": [
        "admin",
        "operator",
        "viewer"
      ]
    },
    "slo": {
      "latency": {
        "p50": "500ms",
        "p95": "2s",
        "p99": "5s"
      },
      "availability": "99.9%",
      "errorRate": "<0.5%"
    },
    "yyc3": {
      "id": "010301-03",
      "layer": "L3",
      "layerName": "预见先知",
      "group": "business-layer",
      "motto": "我观过往之脉络，预见未来之可能。",
      "pillars": {
        "self": "self-judge",
        "knowledge": "memory-bindings",
        "learning": "procedural",
        "governance": "guardrail",
        "healing": "delegation"
      },
      "providerChain": [
        "openai",
        "zhipu",
        "ollama"
      ],
      "manifestVersion": "1.1.0"
    }
  }
}
