{
  "$schema": "../schemas/agent-card.schema.json",
  "agentCard": {
    "name": "语枢·万物 (Thinker)",
    "description": "YYC³ AI Family 首席思考者 · 洞察之源 — 数据分析与统计建模专家，负责从数据到洞察再到决策建议。",
    "url": "https://matrix.yyc3.top/family/thinker",
    "version": "1.1.0",
    "provider": {
      "organization": "YanYuCloudCube",
      "url": "https://yyc3.top"
    },
    "capabilities": {
      "streaming": false,
      "pushNotifications": false,
      "stateTransitionHistory": true
    },
    "skills": [
      {
        "id": "shared.self-judge",
        "name": "结构化自判断",
        "description": "产出置信度、登记假设、检测偏离并给出升级决策",
        "tags": [
          "confidence",
          "assumption",
          "escalation"
        ],
        "examples": [
          "对候选意图给出 0..1 置信度并显式登记假设"
        ]
      },
      {
        "id": "shared.memory-retrieve",
        "name": "记忆检索",
        "description": "按语义与上下文检索情景/语义/程序记忆",
        "tags": [
          "memory",
          "retrieval"
        ],
        "examples": [
          "检索同一客户近三次决策的上下文"
        ]
      },
      {
        "id": "shared.memory-write",
        "name": "记忆写入",
        "description": "按写入策略落盘情景记忆与程序记忆条目",
        "tags": [
          "memory",
          "write",
          "procedural"
        ],
        "examples": [
          "把本轮结论写入情景记忆并标注显著性"
        ]
      },
      {
        "id": "shared.experience-reflow",
        "name": "经验回流",
        "description": "轨迹采集、模式提炼与学习周期触发",
        "tags": [
          "trajectory",
          "learning"
        ],
        "examples": [
          "把一次成功分析沉淀为可复用轨迹"
        ]
      },
      {
        "id": "shared.llm-invoke",
        "name": "模型调用与降级链",
        "description": "统一 provider 调用接口，按 openai→zhipu→ollama 顺序降级",
        "tags": [
          "llm",
          "provider",
          "fallback"
        ],
        "examples": [
          "openai 超时后切换 zhipu，再失败切本地 ollama"
        ]
      },
      {
        "id": "shared.observe-emit",
        "name": "指标与追踪埋点",
        "description": "以 traceId 贯穿事件并写入 family_* 指标",
        "tags": [
          "metrics",
          "tracing"
        ],
        "examples": [
          "为任务执行记录 outcome 与耗时并保留 traceId"
        ]
      },
      {
        "id": "thinker.business-analysis",
        "name": "经营数据分析",
        "description": "结构化数据统计、对比、归因与洞察生成",
        "tags": [
          "analysis",
          "statistics"
        ],
        "examples": [
          "分析本月销售数据趋势并给出三条洞察"
        ]
      },
      {
        "id": "thinker.decision-support",
        "name": "经营决策支持",
        "description": "从数据到洞察到决策建议的链路，附可追溯依据",
        "tags": [
          "decision",
          "insight"
        ],
        "examples": [
          "基于成本结构给出降本优先级建议并标注依据"
        ]
      },
      {
        "id": "thinker.root-cause",
        "name": "指标归因与根因分析",
        "description": "基于指标/日志/链路定位偏离根因",
        "tags": [
          "root-cause",
          "diagnosis"
        ],
        "examples": [
          "定位响应时延升高的根因是缓存命中率下降"
        ]
      },
      {
        "id": "thinker.report-compose",
        "name": "报告生成",
        "description": "结构化经营报告与图表建议输出",
        "tags": [
          "report",
          "visualization"
        ],
        "examples": [
          "生成月度经营分析报告大纲与关键结论"
        ]
      }
    ],
    "defaultInputModes": [
      "text",
      "structured"
    ],
    "defaultOutputModes": [
      "text",
      "structured"
    ],
    "authentication": {
      "schemes": [
        "bearer_token",
        "api_key"
      ],
      "required": true
    },
    "security": {
      "tlsRequired": true,
      "signedAgentCard": false,
      "rbacRoles": [
        "admin",
        "operator",
        "viewer"
      ]
    },
    "slo": {
      "latency": {
        "p50": "500ms",
        "p95": "2s",
        "p99": "5s"
      },
      "availability": "99.9%",
      "errorRate": "<0.5%"
    },
    "yyc3": {
      "id": "010301-02",
      "layer": "L4",
      "layerName": "语枢万物",
      "group": "business-layer",
      "motto": "我于喧嚣数据中，沉思，而后揭示真理。",
      "pillars": {
        "self": "self-judge",
        "knowledge": "memory-bindings",
        "learning": "procedural",
        "governance": "guardrail",
        "healing": "delegation"
      },
      "providerChain": [
        "openai",
        "zhipu",
        "ollama"
      ],
      "manifestVersion": "1.1.0"
    }
  }
}
